<div class="blog-page container py-16 text-center" style="max-width: 800px;">
  <h1 class="text-4xl font-bold text-primary mb-12">{{ blog.title }}</h1>

  {% paginate blog.articles by 10 %}
    <div class="articles-grid d-grid gap-8 text-left" style="grid-template-columns: 1fr;">
      {%- for article in blog.articles -%}
        <article class="article-card border rounded-lg overflow-hidden bg-white hover:shadow-md transition-shadow">
          {%- if article.image -%}
            <a href="{{ article.url }}" class="article-card__image d-block aspect-video overflow-hidden">
              <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.image.alt | escape }}" class="w-full h-full object-cover transition-transform hover:scale-105" loading="lazy">
            </a>
          {%- endif -%}
          
          <div class="article-card__content p-6">
            <div class="article-meta text-xs font-bold text-secondary uppercase tracking-wider mb-3">
              {{ article.published_at | time_tag: format: 'date' }}
            </div>
            
            <h2 class="text-2xl font-bold text-primary mb-3">
              <a href="{{ article.url }}" class="hover:text-accent" style="text-decoration: none;">{{ article.title }}</a>
            </h2>
            
            <div class="text-secondary text-sm mb-4" style="line-height: 1.6;">
              {%- if article.excerpt.size > 0 -%}
                {{ article.excerpt }}
              {%- else -%}
                {{ article.content | strip_html | truncatewords: 30 }}
              {%- endif -%}
            </div>
            
            <a href="{{ article.url }}" class="text-sm font-bold text-accent hover:underline d-inline-flex align-items-center gap-1">
              Read More
              <span style="width: 14px; height: 14px;">{% render 'icon-chevron-right' %}</span>
            </a>
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      {% render 'pagination', paginate: paginate %}
    {%- endif -%}
  {% endpaginate %}
</div>

<style>
  .aspect-video { aspect-ratio: 16 / 9; }
  .object-cover { object-fit: cover; }
  .hover\:scale-105:hover { transform: scale(1.05); }
  .transition-transform { transition: transform 0.3s ease; }
  .hover\:shadow-md:hover { box-shadow: var(--shadow-md); }
</style>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
