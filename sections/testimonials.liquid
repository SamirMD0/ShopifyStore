<div class="testimonials-section py-12 bg-slate-50 relative overflow-hidden" data-animate="slide-up">
  <div class="container">
    <div class="section-header text-center mb-10" style="align-items: center; justify-content: center; flex-direction: column;">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="section-title">{{ section.settings.title }}</h2>
    </div>

    <div class="testimonials-carousel scroll-snap-x gap-6 pb-6">
      {%- for block in section.blocks -%}
        <div class="scroll-snap-item w-full md-w-1-2 lg-w-1-3 testimonial-item-width" {{ block.shopify_attributes }}>
          <div class="testimonial-card glass-card h-full d-flex flex-column">
            <div class="testimonial-rating d-flex gap-1 mb-4" style="color: var(--color-warning);">
              {%- for i in (1..5) -%}
                {%- if i <= block.settings.rating -%}
                  <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                {%- else -%}
                  <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 20 20"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>
                {%- endif -%}
              {%- endfor -%}
            </div>
            
            <p class="testimonial-text flex-1 italic text-secondary text-lg mb-6">"{{ block.settings.text }}"</p>
            
            <div class="testimonial-author d-flex align-items-center gap-3">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 100 }}" class="author-avatar rounded-full object-cover" alt="{{ block.settings.author | escape }}" width="48" height="48" loading="lazy">
              {%- else -%}
                <div class="author-avatar bg-slate-200 rounded-full d-flex align-items-center justify-content-center text-secondary font-bold text-lg" style="width: 48px; height: 48px;">
                  {{ block.settings.author | slice: 0, 1 | upcase }}
                </div>
              {%- endif -%}
              
              <div>
                <div class="font-bold text-primary">{{ block.settings.author }}</div>
                {%- if block.settings.title != blank -%}
                  <div class="text-xs text-secondary">{{ block.settings.title }}</div>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .bg-slate-50 { background-color: #f8fafc; }
  .rounded-full { border-radius: 9999px; }
  .object-cover { object-fit: cover; }
  .testimonials-carousel::-webkit-scrollbar { display: none; }
  .testimonials-carousel { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<style>
  .testimonial-item-width { width: 320px; }
  @media(min-width: 768px) {
    .testimonial-item-width { width: 400px; }
  }
</style>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Testimonials"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "What Our Customers Say"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Star Rating"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Quote",
          "default": "Absolutely fantastic service and product quality. Highly recommend!"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Author Photo"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "John Doe"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Author Title",
          "default": "Verified Buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
