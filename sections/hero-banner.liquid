<div class="hero-section container" data-hero-carousel>
  <div class="d-grid gap-4" style="grid-template-columns: 1fr; {% if section.blocks.size > 2 and section.settings.show_side_promos %}@media(min-width: 1024px) { grid-template-columns: 3fr 1fr; }{% endif %}">
    
    <!-- Main Carousel -->
    <div class="hero-carousel-container relative overflow-hidden rounded-lg">
      <div class="hero-slides d-flex" style="transition: transform 0.5s ease-in-out;">
        {%- for block in section.blocks -%}
          {%- if block.type == 'slide' -%}
            <div class="hero-slide flex-none w-full" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 1600 }}" class="hero-bg-image" alt="{{ block.settings.heading | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'hero-bg-image bg-slate-200' }}
              {%- endif -%}
              
              <div class="hero-overlay"></div>
              
              <div class="hero-content">
                {%- if block.settings.eyebrow != blank -%}
                  <div class="hero-eyebrow">{{ block.settings.eyebrow }}</div>
                {%- endif -%}
                <h2 class="hero-title">{{ block.settings.heading }}</h2>
                {%- if block.settings.subtext != blank -%}
                  <p class="hero-text">{{ block.settings.subtext }}</p>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <a href="{{ block.settings.button_link }}" class="btn btn-primary btn-lg">
                    {{ block.settings.button_label }}
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      
      <!-- Controls -->
      <button class="carousel-control prev absolute top-1/2 left-4 z-10 btn btn-ghost bg-white" style="border-radius: 50%; width: 40px; height: 40px; transform: translateY(-50%); padding: 0;">
        {% render 'icon-chevron-left' %}
      </button>
      <button class="carousel-control next absolute top-1/2 right-4 z-10 btn btn-ghost bg-white" style="border-radius: 50%; width: 40px; height: 40px; transform: translateY(-50%); padding: 0;">
        {% render 'icon-chevron-right' %}
      </button>
      
      <!-- Dots -->
      <div class="carousel-dots absolute bottom-4 w-full d-flex justify-content-center gap-2 z-10">
        {%- assign slide_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'slide' -%}
            <button class="dot bg-white border-0" data-index="{{ slide_index }}" style="width: 10px; height: 10px; border-radius: 50%; opacity: 0.5; cursor: pointer;"></button>
            {%- assign slide_index = slide_index | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <!-- Side Promos -->
    {%- if section.settings.show_side_promos -%}
      <div class="hero-side-promos hidden-desktop d-grid gap-4" style="grid-template-rows: 1fr 1fr; @media(min-width: 1024px) { display: grid !important; }">
        {%- assign promo_count = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'promo' and promo_count < 2 -%}
            <div class="side-promo relative rounded-lg overflow-hidden flex-1 d-flex align-items-center p-6" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 600 }}" class="absolute inset-0 w-full h-full object-cover z-0" alt="{{ block.settings.heading | escape }}" loading="lazy">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'absolute inset-0 w-full h-full bg-slate-200 z-0' }}
              {%- endif -%}
              <div class="absolute inset-0 bg-black opacity-40 z-0"></div>
              
              <div class="relative z-10 text-white">
                <div class="text-xs font-bold uppercase text-accent mb-2">{{ block.settings.eyebrow }}</div>
                <h3 class="text-xl font-bold mb-2">{{ block.settings.heading }}</h3>
                <a href="{{ block.settings.button_link }}" class="text-sm font-medium hover:text-accent d-inline-flex align-items-center gap-1" style="text-decoration: underline; text-underline-offset: 4px;">
                  Shop Now {% render 'icon-chevron-right' %}
                </a>
              </div>
            </div>
            {%- assign promo_count = promo_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
    
  </div>
</div>

<style>
  .carousel-dots .dot.active { opacity: 1; transform: scale(1.2); }
  .side-promo img { transition: transform 0.5s ease; }
  .side-promo:hover img { transform: scale(1.05); }
  .object-cover { object-fit: cover; }
</style>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_side_promos",
      "label": "Show side promotions",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow Text", "default": "New Arrival" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Discover Our Latest Collection" },
        { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Explore premium quality products designed for you." },
        { "type": "text", "id": "button_label", "label": "Button Label", "default": "Shop Now" },
        { "type": "url", "id": "button_link", "label": "Button Link" }
      ]
    },
    {
      "type": "promo",
      "name": "Side Promo",
      "limit": 2,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Clearance" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Up to 50% Off" },
        { "type": "url", "id": "button_link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "promo" },
        { "type": "promo" }
      ]
    }
  ]
}
{% endschema %}
