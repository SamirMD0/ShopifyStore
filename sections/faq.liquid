<div class="faq">
  {% if section.settings.heading %}
    <h2 class="faq__heading">{{ section.settings.heading | escape }}</h2>
  {% endif %}

  <div class="faq__items">
    {% for block in section.blocks %}
      <div class="faq__item" {{ block.shopify_attributes }}>
        <button class="faq__question" aria-expanded="false">
          {{ block.settings.question | escape }}
          <span class="faq__icon">{% render 'icon-chevron-down' %}</span>
        </button>
        <div class="faq__answer" hidden>
          {{ block.settings.answer }}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Frequently asked question?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer to the question.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ"
    }
  ]
}
{% endschema %}
