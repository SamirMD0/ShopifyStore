<div class="list-collections">
  {% if section.settings.heading %}
    <h1 class="list-collections__heading">{{ section.settings.heading | escape }}</h1>
  {% endif %}

  <div class="list-collections__grid">
    {%- for collection in collections -%}
      {% unless collection.handle == 'frontpage' or collection.handle == 'all' %}
        {% render 'collection-card', collection: collection %}
      {% endunless %}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "List collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections"
    }
  ],
  "presets": [
    {
      "name": "List collections"
    }
  ]
}
{% endschema %}
