<div class="cart-page-section container py-12">
  <div class="section-header mb-8">
    <h1 class="text-3xl font-bold text-primary">Your Cart</h1>
    <a href="{{ routes.all_products_collection_url }}" class="text-secondary hover:text-accent" style="text-decoration: underline;">Continue shopping</a>
  </div>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" id="cart-form" class="cart-form d-flex flex-column lg:flex-row gap-8">
      
      <!-- Cart Items -->
      <div class="cart-items-wrapper flex-1 w-full lg:w-2/3" style="@media(min-width: 1024px) { width: 66.666%; }">
        <div class="cart-table-header hidden-mobile d-grid mb-4 text-xs font-bold text-secondary uppercase tracking-wider border-bottom pb-2" style="grid-template-columns: 3fr 1fr 1fr;">
          <div>Product</div>
          <div class="text-center">Quantity</div>
          <div class="text-right">Total</div>
        </div>

        <div class="cart-items d-flex flex-column gap-6">
          {%- for item in cart.items -%}
            <div class="cart-item d-grid align-items-center gap-4 py-4 border-bottom" style="grid-template-columns: 1fr; @media(min-width: 768px) { grid-template-columns: 3fr 1fr 1fr; }">
              
              <!-- Product Info -->
              <div class="cart-item-info d-flex align-items-center gap-4">
                <a href="{{ item.url }}" class="cart-item-image flex-none rounded-sm border overflow-hidden" style="width: 100px; height: 100px;">
                  {%- if item.image -%}
                    <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" class="w-full h-full object-cover">
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'w-full h-full bg-slate-100 object-cover' }}
                  {%- endif -%}
                </a>
                
                <div class="cart-item-details flex-1">
                  <a href="{{ item.url }}" class="font-bold text-primary hover:text-accent mb-1 d-block" style="text-decoration: none;">
                    {{ item.product.title }}
                  </a>
                  
                  {%- unless item.product.has_only_default_variant -%}
                    <div class="text-sm text-secondary mb-2">{{ item.variant.title }}</div>
                  {%- endunless -%}
                  
                  <div class="text-sm text-primary mb-2 hidden-desktop">{{ item.price | money }}</div>
                  
                  <a href="{{ item.url_to_remove }}" class="text-xs text-error hover:text-primary" style="text-decoration: underline;">Remove</a>
                </div>
              </div>

              <!-- Quantity -->
              <div class="cart-item-quantity d-flex justify-content-start md:justify-content-center">
                <quantity-input class="quantity border rounded-sm d-flex overflow-hidden" style="border-color: var(--color-border); height: 40px; width: 120px;">
                  <button class="quantity__button flex-none w-10 d-flex align-items-center justify-content-center bg-transparent border-0 cursor-pointer hover:bg-slate-50" name="minus" type="button" aria-label="Decrease quantity">
                    <span style="width: 14px; height: 14px;">{% render 'icon-minus' %}</span>
                  </button>
                  <input class="quantity__input flex-1 border-0 bg-transparent text-center font-medium m-0 p-0 text-base"
                      type="number"
                      name="updates[]"
                      value="{{ item.quantity }}"
                      min="0"
                      aria-label="Quantity"
                    >
                  <button class="quantity__button flex-none w-10 d-flex align-items-center justify-content-center bg-transparent border-0 cursor-pointer hover:bg-slate-50" name="plus" type="button" aria-label="Increase quantity">
                    <span style="width: 14px; height: 14px;">{% render 'icon-plus' %}</span>
                  </button>
                </quantity-input>
              </div>

              <!-- Total -->
              <div class="cart-item-total text-right font-bold text-primary hidden-mobile">
                {{ item.final_line_price | money }}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <!-- Cart Summary -->
      <div class="cart-summary flex-none w-full lg:w-1/3" style="@media(min-width: 1024px) { width: 33.333%; }">
        <div class="cart-summary-box p-6 bg-slate-50 rounded-lg border">
          <h3 class="font-bold text-lg mb-4">Order Summary</h3>
          
          <div class="d-flex justify-content-between align-items-center mb-6 pb-4 border-bottom">
            <span class="text-secondary font-medium">Subtotal</span>
            <span class="font-bold text-xl text-primary">{{ cart.total_price | money }}</span>
          </div>

          <p class="text-xs text-secondary mb-6 text-center">Taxes and shipping calculated at checkout</p>
          
          <button type="submit" name="update" class="btn btn-outline w-full mb-3" style="display: none;">
            Update Cart
          </button>
          
          <button type="submit" name="checkout" class="btn btn-primary btn-lg w-full font-bold">
            Proceed to Checkout
          </button>
        </div>
      </div>
      
    </form>
  {%- else -%}
    <div class="empty-cart py-20 text-center border rounded-lg bg-slate-50">
      <span class="d-inline-block text-secondary mb-4" style="width: 64px; height: 64px;">
        {% render 'icon-cart' %}
      </span>
      <h2 class="text-2xl font-bold text-primary mb-2">Your cart is empty</h2>
      <p class="text-secondary mb-6">Looks like you haven't added any items yet.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary btn-lg">
        Start Shopping
      </a>
    </div>
  {%- endif -%}
</div>

<style>
  .bg-slate-50 { background-color: #f8fafc; }
  .border-bottom { border-bottom: 1px solid var(--color-border); }
  .tracking-wider { letter-spacing: 0.05em; }
  .object-cover { object-fit: cover; }
  
  /* Show update button if JS is disabled */
  .no-js .cart-summary-box [name="update"] {
    display: block !important;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('cart-form');
    if(!form) return;
    
    // Auto-update cart when quantity input changes in the full cart page
    const qtyInputs = form.querySelectorAll('input[name="updates[]"]');
    qtyInputs.forEach(input => {
      input.addEventListener('change', () => form.submit());
    });
    
    // Auto-update on plus/minus buttons
    const qtyButtons = form.querySelectorAll('.quantity__button');
    qtyButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const input = btn.parentElement.querySelector('input');
        let qty = parseInt(input.value);
        if (btn.name === 'plus') qty++;
        if (btn.name === 'minus') qty = Math.max(0, qty - 1);
        input.value = qty;
        form.submit();
      });
    });
  });
</script>

{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}
