<div class="addresses">
  <h1 class="addresses__heading">{{ 'customer.addresses.title' | t }}</h1>
  <a href="{{ routes.account_url }}" class="button">{{ 'customer.account.return' | t }}</a>

  <div class="addresses__list">
    {% for address in customer.addresses %}
      <div class="addresses__item">
        <div class="addresses__item-content">
          {{ address | format_address }}
          {% if address == customer.default_address %}
            <p class="addresses__default">{{ 'customer.addresses.default' | t }}</p>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

  <button class="button" data-address-toggle>
    {{ 'customer.addresses.add_new' | t }}
  </button>
</div>

{% schema %}
{
  "name": "Addresses",
  "settings": [],
  "presets": [
    {
      "name": "Addresses"
    }
  ]
}
{% endschema %}
