<div class="collection-grid">
  <div class="collection-grid__header">
    {% if section.settings.heading %}
      <h2 class="collection-grid__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
  </div>

  <div class="collection-grid__items">
    {% for block in section.blocks %}
      {% assign collection = collections[block.settings.collection] %}
      <div class="collection-grid__item" {{ block.shopify_attributes }}>
        {% render 'collection-card', collection: collection %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Collection grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection grid"
    }
  ]
}
{% endschema %}
