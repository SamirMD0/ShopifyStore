<div class="reset-password">
  <div class="reset-password__form">
    {% form 'reset_customer_password' %}
      <h1 class="reset-password__heading">{{ 'customer.reset_password.title' | t }}</h1>
      <p>{{ 'customer.reset_password.subtext' | t }}</p>

      {{ form.errors | default_errors }}

      <div class="reset-password__field">
        <label for="ResetPassword-password">{{ 'customer.reset_password.password' | t }}</label>
        <input type="password" name="customer[password]" id="ResetPassword-password" autocomplete="new-password" required>
      </div>

      <div class="reset-password__field">
        <label for="ResetPassword-password_confirmation">{{ 'customer.reset_password.password_confirm' | t }}</label>
        <input type="password" name="customer[password_confirmation]" id="ResetPassword-password_confirmation" autocomplete="new-password" required>
      </div>

      <button type="submit" class="button">
        {{ 'customer.reset_password.submit' | t }}
      </button>
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Reset password",
  "settings": [],
  "presets": [
    {
      "name": "Reset password"
    }
  ]
}
{% endschema %}
