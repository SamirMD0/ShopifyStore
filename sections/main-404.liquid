<div class="template-404 container py-20 text-center d-flex flex-column align-items-center justify-content-center min-h-screen">
  <div class="max-w-md mx-auto">
    <div class="mb-8" style="color: var(--color-accent); width: 120px; height: 120px; margin: 0 auto;">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
    </div>
    
    <h1 class="text-4xl font-bold text-primary mb-4">
      {{ 'templates.404.title' | t | default: "Page Not Found" }}
    </h1>
    
    <p class="text-lg text-secondary mb-8">
      {{ 'templates.404.subtext' | t | default: "The page you are looking for might have been removed, had its name changed, or is temporarily unavailable." }}
    </p>
    
    <div class="d-flex gap-4 justify-content-center">
      <a href="{{ routes.root_url }}" class="btn btn-primary btn-lg">
        {{ 'general.continue_shopping' | t | default: "Back to Home" }}
      </a>
      <button class="btn btn-secondary btn-lg" data-drawer-trigger="mobile-search">
        Search Store
      </button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "404 Page",
  "settings": []
}
{% endschema %}
