<div class="video-banner">
  <div class="video-banner__media">
    {% if section.settings.video_url %}
      <iframe
        src="{{ section.settings.video_url }}"
        class="video-banner__iframe"
        allow="autoplay; encrypted-media"
        allowfullscreen
        loading="lazy"
      ></iframe>
    {% elsif section.settings.video %}
      {{
        section.settings.video
        | video_tag: controls: true, autoplay: section.settings.autoplay, loop: section.settings.loop, class: 'video-banner__video'
      }}
    {% endif %}
  </div>

  <div class="video-banner__content">
    {% if section.settings.heading %}
      <h2 class="video-banner__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    {% if section.settings.text %}
      <p class="video-banner__text">{{ section.settings.text | escape }}</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Video banner",
  "settings": [
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video URL",
      "accept": ["youtube", "vimeo"],
      "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Upload video"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    }
  ],
  "presets": [
    {
      "name": "Video banner"
    }
  ]
}
{% endschema %}
