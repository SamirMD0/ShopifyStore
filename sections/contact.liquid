<div class="contact">
  <div class="contact__content">
    {% if section.settings.heading %}
      <h2 class="contact__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    {% if section.settings.description %}
      <p class="contact__description">{{ section.settings.description | escape }}</p>
    {% endif %}

    {% form 'contact' %}
      {{ form.errors | default_errors }}

      <div class="contact__fields">
        <div class="contact__field">
          <label for="ContactFormName">{{ 'contact.form.name' | t }}</label>
          <input type="text" name="contact[name]" id="ContactFormName" value="{{ form.name }}" required>
        </div>

        <div class="contact__field">
          <label for="ContactFormEmail">{{ 'contact.form.email' | t }}</label>
          <input type="email" name="contact[email]" id="ContactFormEmail" value="{{ form.email }}" autocorrect="off" autocapitalize="off" required>
        </div>

        <div class="contact__field">
          <label for="ContactFormMessage">{{ 'contact.form.message' | t }}</label>
          <textarea name="contact[body]" id="ContactFormMessage" rows="5" required>{{ form.body }}</textarea>
        </div>

        <button type="submit" class="button contact__submit">
          {{ 'contact.form.submit' | t }}
        </button>
      </div>

      {% if form.posted_successfully? %}
        <p class="contact__success">{{ 'contact.form.success' | t }}</p>
      {% endif %}
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in touch"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "We'd love to hear from you"
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
