<div class="best-sellers-section container py-16" data-animate="slide-up" data-tabs>
  <div class="section-header align-items-center" style="margin-bottom: var(--space-6);">
    <div class="section-title-wrapper">
      <h2 class="section-title">{{ section.settings.title }}</h2>
    </div>
    
    <div class="tab-triggers d-flex gap-4 overflow-x-auto" style="scrollbar-width: none;">
      {%- for block in section.blocks -%}
        <button 
          class="tab-btn font-medium text-sm text-secondary hover:text-primary py-2 position-relative {% if forloop.first %}is-active text-primary{% endif %}" 
          data-tab-target="tab-{{ section.id }}-{{ forloop.index }}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.title | default: block.settings.collection.title | default: 'Tab' }}
          <span class="tab-indicator absolute bottom-0 left-0 w-full h-0.5 bg-accent {% unless forloop.first %}d-none{% endunless %}"></span>
        </button>
      {%- endfor -%}
    </div>
  </div>

  <div class="tab-content-container relative min-h-[400px]">
    {%- for block in section.blocks -%}
      {%- assign collection = block.settings.collection -%}
      <div id="tab-{{ section.id }}-{{ forloop.index }}" class="tab-content {% if forloop.first %}is-active{% else %}d-none{% endif %}">
        
        <div class="product-rail scroll-snap-x gap-4 pb-4">
          {%- if collection != blank and collection.products_count > 0 -%}
            {%- for product in collection.products limit: section.settings.product_limit -%}
              <div class="scroll-snap-item" style="width: 280px;">
                {% render 'product-card', product: product, collection: collection %}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              <div class="scroll-snap-item" style="width: 280px;">
                <!-- Placeholder Product Card -->
                <div class="product-card">
                  <div class="product-card-image-wrapper">
                    {{ 'product-' | append: i | placeholder_svg_tag: 'product-card-image bg-slate-200' }}
                  </div>
                  <div class="product-card-info">
                    <a href="#" class="product-card-title text-primary hover:text-accent">Example Product {{ i }}</a>
                    <div class="product-card-price">
                      <span class="product-card-price-regular">$29.99</span>
                    </div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>

      </div>
    {%- endfor -%}
  </div>
</div>

<style>
  .tab-btn { border: none; background: transparent; cursor: pointer; white-space: nowrap; }
  .tab-indicator { height: 2px; }
  .tab-content { animation: fadeIn 0.3s ease; }
  
  .product-rail { padding-bottom: var(--space-4); margin-bottom: calc(-1 * var(--space-4)); }
  .product-rail::-webkit-scrollbar { display: none; }
  .product-rail { -ms-overflow-style: none; scrollbar-width: none; }
  
  @media (min-width: 1024px) {
    .product-rail {
      display: grid;
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
      overflow-x: visible;
    }
    .scroll-snap-item { width: auto !important; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const tabsSections = document.querySelectorAll('[data-tabs]');
    
    tabsSections.forEach(section => {
      const triggers = section.querySelectorAll('.tab-btn');
      const contents = section.querySelectorAll('.tab-content');
      
      triggers.forEach(trigger => {
        trigger.addEventListener('click', () => {
          // Reset all
          triggers.forEach(t => {
            t.classList.remove('is-active', 'text-primary');
            t.classList.add('text-secondary');
            t.querySelector('.tab-indicator').classList.add('d-none');
          });
          contents.forEach(c => c.classList.add('d-none'));
          
          // Activate clicked
          trigger.classList.add('is-active', 'text-primary');
          trigger.classList.remove('text-secondary');
          trigger.querySelector('.tab-indicator').classList.remove('d-none');
          
          const targetId = trigger.getAttribute('data-tab-target');
          document.getElementById(targetId).classList.remove('d-none');
        });
      });
    });
  });
</script>

{% schema %}
{
  "name": "Best Sellers (Tabbed)",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Maximum products per tab"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Number of columns on desktop"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Collection Tab",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab Title",
          "info": "Leave blank to use collection title"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best Sellers (Tabbed)",
      "blocks": [
        { "type": "tab", "settings": { "title": "Top Picks" } },
        { "type": "tab", "settings": { "title": "Trending" } }
      ]
    }
  ]
}
{% endschema %}
