<meta name="theme-color" content="{{ settings.primary_color }}">
<meta name="format-detection" content="telephone=no">

{%- if template contains 'product' -%}
  <meta property="og:type" content="product">
  <meta property="og:title" content="{{ product.title | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:description" content="{{ product.description | strip_html | truncate: 200 | escape }}">
  {%- if product.featured_image -%}
    <meta property="og:image" content="http:{{ product.featured_image | image_url: width: 600 }}">
    <meta property="og:image:secure_url" content="https:{{ product.featured_image | image_url: width: 600 }}">
    <meta property="og:image:width" content="600">
    <meta property="og:image:height" content="{{ 600 | divided_by: product.featured_image.aspect_ratio | round }}">
  {%- endif -%}
  <meta property="product:price:amount" content="{{ product.price_min | money_without_currency | remove: ',' }}">
  <meta property="product:price:currency" content="{{ shop.currency }}">

{%- elsif template contains 'article' -%}
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ article.title | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:description" content="{{ article.excerpt_or_content | strip_html | truncate: 200 | escape }}">
  {%- if article.image -%}
    <meta property="og:image" content="http:{{ article.image | image_url: width: 600 }}">
    <meta property="og:image:secure_url" content="https:{{ article.image | image_url: width: 600 }}">
  {%- endif -%}

{%- elsif template contains 'collection' -%}
  <meta property="og:type" content="product.group">
  <meta property="og:title" content="{{ collection.title | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:description" content="{{ collection.description | strip_html | truncate: 200 | escape }}">
  {%- if collection.image -%}
    <meta property="og:image" content="http:{{ collection.image | image_url: width: 600 }}">
    <meta property="og:image:secure_url" content="https:{{ collection.image | image_url: width: 600 }}">
  {%- endif -%}

{%- elsif template contains 'page' -%}
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ page.title | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:description" content="{{ page_description | escape }}">

{%- else -%}
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:description" content="{{ page_description | escape }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page_title | escape }}">
<meta name="twitter:description" content="{{ page_description | escape }}">
