<div class="product-accordion-wrapper mt-8 border-top" {{ block.shopify_attributes }}>
  <div class="accordion-item border-bottom py-4">
    <button class="accordion-summary w-full d-flex justify-content-between align-items-center bg-transparent border-0 p-0 cursor-pointer text-primary" aria-expanded="false" data-accordion-trigger>
      <h3 class="font-bold text-base m-0">{{ block.settings.title | default: "Product Description" }}</h3>
      <span class="icon-wrap transition-transform" style="width: 20px; height: 20px;">
        {% render 'icon-chevron-down' %}
      </span>
    </button>
    <div class="accordion-content mt-4 text-secondary text-sm" style="display: none;">
      {%- if block.settings.content != blank -%}
        {{ block.settings.content }}
      {%- else -%}
        {{ product.description }}
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .accordion-summary[aria-expanded="true"] .icon-wrap { transform: rotate(180deg); }
  .accordion-summary[aria-expanded="true"] + .accordion-content { display: block; animation: fadeIn 0.3s ease; }
  .border-top { border-top: 1px solid var(--color-border); }
  .border-bottom { border-bottom: 1px solid var(--color-border); }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const triggers = document.querySelectorAll('[data-accordion-trigger]');
    triggers.forEach(trigger => {
      trigger.addEventListener('click', function() {
        const expanded = this.getAttribute('aria-expanded') === 'true';
        this.setAttribute('aria-expanded', !expanded);
      });
      
      // Expand first accordion by default if needed
      // if(trigger === triggers[0]) {
      //   trigger.setAttribute('aria-expanded', 'true');
      // }
    });
  });
</script>
