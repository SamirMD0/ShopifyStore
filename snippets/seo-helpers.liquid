{%- if template contains 'product' -%}
  <script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_image -%}
      "image": [
        {{ product.featured_image | image_url: width: product.featured_image.width | prepend: 'https:' | json }}
      ],
    {%- endif -%}
    "description": {{ product.description | strip_html | json }},
    {%- if product.selected_or_first_available_variant.sku != blank -%}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
    {%- endif -%}
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | json }}
    },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          "url": {{ request.origin | append: variant.url | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "price": {{ variant.price | money_without_currency | remove: ',' | json }},
          "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "itemCondition": "http://schema.org/NewCondition"
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>

{%- elsif template contains 'article' -%}
  <script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Article",
    "articleBody": {{ article.content | strip_html | json }},
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ request.origin | append: article.url | json }}
    },
    "headline": {{ article.title | json }},
    {%- if article.image -%}
      "image": [
        {{ article.image | image_url: width: article.image.width | prepend: 'https:' | json }}
      ],
    {%- endif -%}
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "dateCreated": {{ article.created_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "author": {
      "@type": "Person",
      "name": {{ article.author | json }}
    },
    "publisher": {
      "@type": "Organization",
      "name": {{ shop.name | json }}
    }
  }
  </script>

{%- elsif template contains 'collection' and collection.description != blank -%}
  <script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "ItemList",
    "itemListElement": [
      {%- for product in collection.products -%}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "url": {{ request.origin | append: product.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    "description": {{ collection.description | strip_html | json }}
  }
  </script>

{%- elsif template contains 'page' -%}
  <script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "WebPage",
    "name": {{ page.title | json }},
    "description": {{ page_description | json }}
  }
  </script>

{%- endif -%}

{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "WebSite",
    "name": {{ shop.name | json }},
    "url": {{ request.origin | json }}
  }
  </script>
{%- endif -%}
